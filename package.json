{
  "name": "opusage",
  "version": "0.1.0",
  "description": "Track OpenCode token usage and cost per project, model, and session — zero-dependency CLI plus a live TUI widget",
  "type": "module",
  "license": "MIT",
  "author": "sarthakmahapatra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarthakmahapatra/opusage.git"
  },
  "bugs": {
    "url": "https://github.com/sarthakmahapatra/opusage/issues"
  },
  "homepage": "https://github.com/sarthakmahapatra/opusage#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "opusage": "./bin/opusage.js"
  },
  "exports": {
    ".": "./src/server.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "keywords": [
    "opencode",
    "tokens",
    "usage",
    "cost",
    "llm",
    "cli",
    "tui"
  ],
  "dependencies": {
    "@opencode/plugin": "^2.0.22",
    "@opencode/theme": "^2.0.22",
    "@opentui/core": "^0.5.14",
    "@opentui/solid": "^0.5.14",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "devlink": "node scripts/devlink.mjs"
  }
}
